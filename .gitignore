### C
# Object files
*.o
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out

# Linker output
*.ilk
*.map
*.exp

# Debug files
*.dSYM/
*.idb
*.pdb

### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

### VS Code
# VSCode settings (keep shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Do not include WAD files, potential licensing issues
*.WAD

# Include the shareware demo WAD file
!WADs/DOOM1.WAD

build
*.z64
*.log
filesystem

# Bench harness local save artifacts -- must never be tracked or seeded into a
# run. A blank/stale save on disk could otherwise drift the deterministic A/B
# scenario (and the per-run mktemp workdir means they leak nothing anyway).
bench/bench-baseline.eeprom
bench/bench-baseline.pak
bench/last-overlay.png
*.eeprom
*.pak
